# Copy to .env and fill in. .env is git-ignored.

# --- AWS ---
AWS_REGION=ca-central-1
AWS_PROFILE=mlops-aiops

# Project resource prefix — must match infra/ var.project
MLOPS_PROJECT=mlops-aiops

# S3 data-lake bucket (created by infra/). Zones are prefixes within it:
#   s3://$MLOPS_BUCKET/raw/311/asof=YYYY-MM-DD/
#   s3://$MLOPS_BUCKET/processed/311/year=YYYY/month=MM/
#   s3://$MLOPS_BUCKET/model-artifacts/
#   s3://$MLOPS_BUCKET/scored/
MLOPS_BUCKET=mlops-aiops-datalake-CHANGEME
MLOPS_ATHENA_OUTPUT=s3://mlops-aiops-athena-results-CHANGEME/
MLOPS_GLUE_DATABASE=mlops_aiops
# Athena workgroup created by infra/ (holds the 2 GB per-query scan cap)
MLOPS_ATHENA_WORKGROUP=mlops-aiops

# --- Socrata / Calgary Open Data ---
# Free app token: https://data.calgary.ca/profile/edit/developer_settings
SOCRATA_DOMAIN=data.calgary.ca
SOCRATA_311_RESOURCE=iahh-g8bj
SOCRATA_APP_TOKEN=

# --- Cost ---
# Must match infra/ var.series_start (date part). nuke.sh reports account spend since then.
MLOPS_SERIES_START=2026-09-01

# --- CloudWatch custom metrics ---
MLOPS_METRIC_NAMESPACE=MLOpsAIOps/Pipeline

# --- Model Registry (Stage 4 registers here; Stage 6 reads the latest Approved) ---
MLOPS_MODEL_PACKAGE_GROUP=mlops-aiops-breach-risk
